{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "YML Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gr-OOT_HDL/python/OOT_HDL/YAML_generator.py",
            "console": "integratedTerminal"
        },
        
        
        {
            "name": "YML Generator - generate with arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gr-OOT_HDL/python/OOT_HDL/YAML_generator.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/grc/OOT_HDL_HDL_module.block_gen.yml"
            ]
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/multiplier.v"
            ]
        }
    ]
}